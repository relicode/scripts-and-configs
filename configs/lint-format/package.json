{
  "private": true,
  "type": "module",
  "scripts": {
    "format": "concurrently --max-processes 1 --prefix-colors auto --kill-others-on-fail 'bun:format:biome' 'bun:format:eslint' 'bun:format:prettier'",
    "format:biome": "biome check --write",
    "format:eslint": "eslint --fix",
    "format:prettier": "prettier --write '**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,json5,md,css,yaml,yml}'",
    "lint": "concurrently --prefix-colors auto 'bun:lint:*'",
    "lint:biome": "biome check",
    "lint:eslint": "eslint",
    "lint:prettier": "prettier --check '**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,json5,md,css,yaml,yml}'",
    "lint:typescript": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@eslint-react/eslint-plugin": "^5.7.8",
    "@eslint/css": "^1.2.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.1",
    "@types/bun": "^1.3.14",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  }
}
