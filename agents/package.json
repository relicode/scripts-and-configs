{
  "name": "skillster",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "^1.4.0"
  },
  "scripts": {
    "lint": "bun run --parallel --no-exit-on-error 'lint:*'",
    "lint:biome": "biome check --error-on-warnings",
    "lint:claude": "bun scripts/lint-claude.ts",
    "lint:types": "tsc --noEmit -p tsconfig.json",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
